{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://test-chertezh.local/schemas/pipeline_length_response.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["candidate_assessments", "unresolved_reviews", "edge_routes", "vertex_coordinates"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "candidate_assessments": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "assessment"], "additionalProperties": true, "properties": {
      "candidate_id": {"type": "string"},
      "candidate_key": {"type": "string"},
      "local_decision": {"type": ["string", "null"]},
      "assessment": {"type": "string", "enum": ["accepted", "disputed", "insufficient"]},
      "proposed_decision": {"type": ["string", "null"]},
      "target_final_edge_id": {"type": ["string", "null"]},
      "reason": {"type": "string"}
    }}},
    "unresolved_reviews": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "status"], "additionalProperties": true, "properties": {
      "candidate_id": {"type": "string"},
      "candidate_key": {"type": "string"},
      "status": {"type": "string"},
      "reason": {"type": "string"},
      "suggested_action": {"type": "string"}
    }}},
    "edge_routes": {"type": "array", "items": {"type": "object", "required": ["edge_id", "route_type"], "additionalProperties": true}},
    "branch_routes": {"type": "array", "items": {"type": "object", "required": ["branch_id", "edge_ids", "candidate_ids"], "additionalProperties": true}},
    "route_segments": {"type": "array", "items": {"type": "object", "required": ["segment_id", "route_type", "candidate_ids"], "additionalProperties": true}},
    "cross_sheet_links": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "intermediate_distances": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "vertex_coordinates": {"type": "array", "items": {"type": "object", "required": ["vertex_id"], "additionalProperties": true, "properties": {
      "vertex_id": {"type": "string"},
      "vertex_key": {"type": "string"},
      "page": {"type": ["integer", "string", "null"]},
      "x": {"type": ["number", "null"]},
      "y": {"type": ["number", "null"]},
      "z": {"type": ["number", "null"]},
      "confidence": {"type": ["number", "null"]},
      "method": {"type": "string"},
      "source_coordinate_labels": {"type": "array", "items": {"type": "string"}},
      "reason": {"type": "string"}
    }}},
    "lengths": {"type": "object", "required": ["main", "branch"], "additionalProperties": true}
  }
}
